# ── AI ────────────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── AI — Vision (OpenAI / gpt-4o-mini) ───────────────────────────────────────
VISION_API_KEY=sk-your-openai-key   # get at platform.openai.com
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4o-mini

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_BOT_USERNAME=YourBotUsername   # without @

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
BOT_API_KEY=change-me-to-another-random-string  # shared secret between bot and backend
ASSET_ENCRYPTION_KEY=generate-with-python-c-from-cryptography.fernet-import-Fernet-print-Fernet.generate_key().decode()

# ── External tools ───────────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-your-key-here   # get free key at https://tavily.com (1000 searches/mo free)
# Stock/crypto data uses yfinance (Yahoo Finance) — no key needed
# Weather uses Open-Meteo — no key needed

# ── Server ────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
BOT_API_BASE=https://kokofantasy.online   # used by the telegram bot to reach the backend
