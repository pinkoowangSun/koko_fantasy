# ── AI ────────────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_BOT_USERNAME=YourBotUsername   # without @

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
BOT_API_KEY=change-me-to-another-random-string  # shared secret between bot and backend

# ── Server ────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
BOT_API_BASE=http://localhost:8000   # used by the telegram bot to reach the backend
